# ─────────────────────────────────────────────────────────
# Production environment template
# Copy to .env.prod and fill in ALL values before deploying
# NEVER commit .env.prod to version control
# ─────────────────────────────────────────────────────────

ENVIRONMENT=production

# ── App ───────────────────────────────────────────────────
# REQUIRED: 64+ random characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_MUST_BE_64_PLUS_RANDOM_CHARACTERS

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database ──────────────────────────────────────────────
# These are used by docker-compose.prod.yml for db service AND connection strings
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=unified_backend

DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}
SYNC_DATABASE_URL=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Celery ────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Cloudflare R2 (file storage) ─────────────────────────
CLOUDFLARE_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=CHANGE_ME
CLOUDFLARE_R2_SECRET_ACCESS_KEY=CHANGE_ME
CLOUDFLARE_R2_BUCKET_NAME=CHANGE_ME
R2_PUBLIC_URL=https://your-r2-public-domain.com

# ── LLM (OpenRouter) ──────────────────────────────────────
OPENROUTER_API_KEY=CHANGE_ME

# ── Email (SendGrid / SMTP) ───────────────────────────────
SENDGRID_API_KEY=CHANGE_ME
EMAIL_FROM=noreply@yourdomain.com

# ── OAuth ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# ── Frontend ──────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com
