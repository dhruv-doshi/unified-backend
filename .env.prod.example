# ─────────────────────────────────────────────────────────
# Production environment template
# Copy to .env.prod and fill in ALL values before deploying
# NEVER commit .env.prod to version control
# ─────────────────────────────────────────────────────────

ENVIRONMENT=production

# ── App ───────────────────────────────────────────────────
# REQUIRED: 64+ random characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_MUST_BE_64_PLUS_RANDOM_CHARACTERS

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Database ──────────────────────────────────────────────
# Used by docker-compose.prod.yml for the db service AND in the connection strings below
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=unified_backend

DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}
SYNC_DATABASE_URL=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Celery ────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Cloudflare R2 (file storage) ─────────────────────────
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_NAME=CHANGE_ME
R2_PUBLIC_BASE_URL=https://your-r2-public-domain.com

# ── LLM (OpenRouter) ──────────────────────────────────────
OPENROUTER_API_KEY=CHANGE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Sarvam AI (Speech-to-Text) ────────────────────────────
# Get your API key at: https://dashboard.sarvam.ai
SARVAM_API_KEY=CHANGE_ME
SARVAM_LANGUAGE_CODE=unknown

# ── Email (SMTP) ──────────────────────────────────────────
# Gmail example: use an App Password (not your account password)
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=CHANGE_ME_APP_PASSWORD
SMTP_FROM_NAME=Shoot Right

# ── OAuth ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# ── Frontend ──────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com
